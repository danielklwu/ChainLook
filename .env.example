# Copy this file to .env and fill in your credentials.
# ChainLook loads this automatically at startup via python-dotenv.

# --- Required ---

# Google Gemini API key
# https://ai.google.dev/
GOOGLE_API_KEY=

# Search API key (choose one and set the provider accordingly)
SERPAPI_KEY=
# GOOGLE_CUSTOM_SEARCH_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=

# NVD (National Vulnerability Database) API key — optional but recommended.
# Without it requests are rate-limited to 5/30s; with it the limit is 50/30s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Optional ---

# Gemini model to use (default: gemini-2.5-flash)
# CHAINLOOK_GEMINI_MODEL=gemini-2.5-flash

# Override the default cache directory
# CHAINLOOK_CACHE_DIR=cache
